{
  "format": "ontology-schema/v1",
  "domain": "work",
  "version": 1,
  "namespace": {
    "instance": "vps://palantirkc",
    "account": "root"
  },
  "scope_keys": [],
  "value_types": {},
  "sources": {
    "src": {
      "kind": "json_records",
      "path": "x.json"
    }
  },
  "object_types": {
    "thing": {
      "owner": "ontology",
      "primary_key": {
        "from": "$action_id"
      },
      "title": "name",
      "properties": {
        "name": {
          "type": "string",
          "required": true
        }
      }
    }
  },
  "link_types": {},
  "action_types": {
    "act": {
      "parameters": {
        "thing": {
          "type": {
            "ref": "thing"
          },
          "required": true
        }
      },
      "submission_criteria": [
        {
          "code": "c1",
          "message": "m",
          "all": [
            {
              "linked": {
                "from": "$thing",
                "link": "missing",
                "where": {
                  "all": [
                    {
                      "eq": [
                        "name",
                        "x"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      ],
      "rules": []
    }
  },
  "functions": {},
  "grants": []
}
