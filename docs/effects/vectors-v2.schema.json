{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ontology-platform:effects:vectors-v2",
  "type": "object",
  "properties": {
    "format": {
      "const": "effect-vectors/v2"
    },
    "selection": {
      "const": "first_matching_row"
    },
    "states": {
      "const": [
        "unrecorded",
        "pre_effect_recorded",
        "dispatch_possible",
        "answer_returned",
        "answer_lost",
        "timeout_returned",
        "async_accepted",
        "rejected",
        "applied",
        "not_applied",
        "conflict",
        "not_observable",
        "manual_reconciliation"
      ]
    },
    "evidence_kinds": {
      "const": [
        "target_token",
        "returned_value",
        "operation_record",
        "complete_absence",
        "none"
      ]
    },
    "domains": {
      "const": {
        "stage": [
          "absent",
          "prepared",
          "fenced",
          "settled"
        ],
        "saved_state": [
          null,
          "applied",
          "not_applied",
          "rejected",
          "conflict"
        ],
        "answer": [
          "none",
          "lost",
          "returned_ack",
          "completed_returned",
          "returned_timeout",
          "accepted",
          "rejected_no_effect",
          "completed_no_effect"
        ],
        "later_read": [
          "not_read",
          "unavailable",
          "desired",
          "before",
          "other",
          "token_applied_current",
          "token_applied_diverged",
          "token_sealed",
          "token_rejected",
          "token_conflict_no_effect",
          "operation_pending",
          "operation_applied_verified",
          "operation_no_effect",
          "operation_conflict_no_effect",
          "operation_rejected",
          "operation_done_unverified",
          "operation_unobservable",
          "absence_desired_closed",
          "absence_undesired_closed",
          "absence_open",
          "incomplete_absence",
          "identity_mismatch",
          "contradictory",
          "budget_exhausted"
        ]
      }
    },
    "allowed_next_steps": {
      "const": [
        "nothing",
        "read_again",
        "new_attempt_new_identity",
        "never_retry",
        "ask_person"
      ]
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      },
      "minItems": 1
    },
    "normalization": {
      "type": "object",
      "properties": {
        "selection": {
          "const": "first_matching_rule_per_output"
        },
        "predicate_combination": {
          "const": "all"
        },
        "predicate_paths": {
          "const": "raw_input_json_pointer"
        },
        "outputs_independent": {
          "const": true
        },
        "recorded_facts": {
          "const": "copy_unchanged"
        },
        "answer_rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/answerRule"
          },
          "minItems": 1
        },
        "later_read_rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/readRule"
          },
          "minItems": 1
        }
      },
      "required": [
        "selection",
        "predicate_combination",
        "predicate_paths",
        "outputs_independent",
        "recorded_facts",
        "answer_rules",
        "later_read_rules"
      ],
      "additionalProperties": false
    },
    "normalization_cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/normalizationCase"
      },
      "minItems": 1
    }
  },
  "required": [
    "format",
    "selection",
    "states",
    "evidence_kinds",
    "domains",
    "allowed_next_steps",
    "rows",
    "normalization",
    "normalization_cases"
  ],
  "additionalProperties": false,
